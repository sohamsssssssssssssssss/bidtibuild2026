{
  "name": "civicpulse-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:test": "bash scripts/db-test/run.sh",
    "demo:reset": "node scripts/demo-reset.ts",
    "demo:check": "node scripts/demo-check.ts",
    "test:unit": "node --import ./tests/integration/register.ts --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import ./tests/integration/register.ts --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^2.119.0",
    "typescript": "^7.0.2"
  }
}
