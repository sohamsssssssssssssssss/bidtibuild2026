{
  "name": "civicpulse-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:test": "bash scripts/db-test/run.sh",
    "demo:reset": "node scripts/demo-reset.ts",
    "test:unit": "node --import ./tests/integration/register.ts --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import ./tests/integration/register.ts --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts/copy-maplibre-worker.mjs",
    "format:check": "prettier --check \"src/app/**/*.tsx\" \"src/app/(citizen)/report/photo.ts\" \"src/app/globals.css\" \"src/components/**/*.{ts,tsx}\" \"src/lib/supabase/{browser,proxy}.ts\" \"src/proxy.ts\" \"scripts/copy-maplibre-worker.mjs\" \"eslint.config.mjs\" \"postcss.config.mjs\" \"package.json\"",
    "test": "node --test tests/*.test.mjs && npm run test:unit",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "pretest": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "maplibre-gl": "6.11.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^2.119.0",
    "typescript": "6.0.3",
    "@tailwindcss/postcss": "4.1.13",
    "tailwindcss": "4.1.13",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "prettier": "3.6.2"
  }
}
